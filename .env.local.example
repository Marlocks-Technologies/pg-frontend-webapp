# Copy to .env.local.
#
# Local development
# ─────────────────
# Prod API Gateway allows exactly one origin (the Vercel deployment), so a
# browser on localhost is rejected at the CORS preflight. Leave these two
# pointed at the relative path below and next.config.js proxies the calls
# through the Next dev server, which makes them same-origin.
NEXT_PUBLIC_API_BASE_URL=/api/backend
NEXT_PUBLIC_DOCUMENT_BASE_URL=/api/backend

# Which backend the dev proxy forwards to. Defaults to prod when unset; point
# it at dev or staging (both allow all origins) to keep test traffic off prod.
# API_PROXY_TARGET=https://r17l0a5vbi.execute-api.eu-west-1.amazonaws.com/prod

# Deployed builds
# ───────────────
# The proxy is not registered in a production build. Set these to the absolute
# API Gateway URL in the Vercel project's environment variables instead:
# NEXT_PUBLIC_API_BASE_URL=https://r17l0a5vbi.execute-api.eu-west-1.amazonaws.com/prod
# NEXT_PUBLIC_DOCUMENT_BASE_URL=https://r17l0a5vbi.execute-api.eu-west-1.amazonaws.com/prod

# PG sign-in and server-side API transport
# Copy to .env.local for local development; set the same server variables in production.
PG_APP_URL=http://localhost:3000
PG_API_BASE_URL=https://r17l0a5vbi.execute-api.eu-west-1.amazonaws.com/prod
PG_SESSION_SECRET=replace-with-at-least-32-random-characters

# From Terraform outputs after deploying the Cognito module.
COGNITO_DOMAIN=https://your-prefix.auth.eu-west-1.amazoncognito.com
COGNITO_ISSUER=https://cognito-idp.eu-west-1.amazonaws.com/your-pool-id
COGNITO_CLIENT_ID=your-client-id
COGNITO_CLIENT_SECRET=your-client-secret

# Existing metered deep research API key; server-only.
RAG_RESEARCH_API_KEY=

# Browser only needs the WebSocket endpoint. A one-use ticket is fetched through
# the authenticated server route before opening a connection.
NEXT_PUBLIC_WEBSOCKET_URL=wss://your-api.execute-api.eu-west-1.amazonaws.com/prod
